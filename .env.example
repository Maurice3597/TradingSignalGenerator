# ---------- Market data ----------
# twelvedata (spot XAU/USD, needs free key from https://twelvedata.com) | yahoo (GC=F futures, no key, unofficial)
DATA_PROVIDER=twelvedata
TWELVEDATA_API_KEY=your_twelvedata_key
TWELVEDATA_SYMBOL=XAU/USD
YAHOO_SYMBOL=GC=F
BARS=500

# ---------- WhatsApp ----------
# callmebot (free, personal use) | twilio | meta | console
WHATSAPP_PROVIDER=callmebot
# Your number in international format, e.g. +237612345678
WHATSAPP_TO=+000000000000

# CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_API_KEY=

# Twilio: https://www.twilio.com/docs/whatsapp/quickstart
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Meta WhatsApp Cloud API: https://developers.facebook.com/docs/whatsapp/cloud-api
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0

# ---------- Behaviour ----------
# change = alert whenever any timeframe signal or confluence changes
# confluence = alert only when a new adjacent-timeframe confluence appears
# always = alert after every 5-minute candle
NOTIFY_MODE=change
STATE_FILE=state.json
CANDLE_CLOSE_DELAY_S=10
SKIP_WEEKEND=true

# ---------- Strategy tuning ----------
ADX_MIN=20
MIN_VOTES=3
SL_ATR_MULT=1.5
TP1_ATR_MULT=1.5
TP2_ATR_MULT=3.0
